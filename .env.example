# =====================================================================================
# IOMETE COMPASS — environment configuration
#
# Copy to `.env` and adjust. Everything here has a working default, so COMPASS runs with
# no configuration at all: SQLite, deterministic AI providers, simulated integrations.
# `.env` is gitignored; never commit real credentials.
# =====================================================================================

# -------------------------------------------------------------------------------------
# Django core
# -------------------------------------------------------------------------------------
# Required in production (compass.settings.prod raises at import without it).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
LOG_LEVEL=INFO

# Marks the deployment as running on synthetic seed data. Surfaced by
# /api/v1/system/status/ and rendered as a banner by the frontend. Set false for a real
# deployment — it also stops /api/v1/auth/demo-accounts/ publishing anything.
COMPASS_DEMO_MODE=true

# -------------------------------------------------------------------------------------
# Database
#
# Unset = SQLite at backend/compass.sqlite3, which needs no infrastructure and is a fully
# supported configuration. Vector search then runs in numpy, which is exact and fast at
# demo scale; /api/v1/system/status/ reports which backend answered.
#
# A Postgres DSN additionally enables the pgvector HNSW index. docker-compose sets this.
# -------------------------------------------------------------------------------------
# DATABASE_URL=postgres://compass:compass@localhost:5432/compass
DB_CONN_MAX_AGE=60

# Uses pgvector when the database is Postgres AND the extension is installed. Never
# claimed when unavailable.
USE_PGVECTOR=true

# -------------------------------------------------------------------------------------
# Encryption of integration credentials at rest
#
# Required in production. Without it, development derives a key from DJANGO_SECRET_KEY so
# the feature still works rather than silently storing plaintext.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -------------------------------------------------------------------------------------
COMPASS_ENCRYPTION_KEY=

# -------------------------------------------------------------------------------------
# JWT
# -------------------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Defaults to DJANGO_SECRET_KEY when unset.
JWT_SIGNING_KEY=

# -------------------------------------------------------------------------------------
# CORS / CSRF — the frontend origin. Never use "*" with credentials.
# -------------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------------------------------------------------
# AI providers
#
# LLM_PROVIDER=demo is a deterministic, offline provider that composes answers from the
# retrieved records. It is not a stub: the whole product is demonstrable with it, and the
# API always discloses `provider: "demo"` so nothing is passed off as model output.
#
# Set LLM_PROVIDER=gemini AND GEMINI_API_KEY to use a live model. Setting the provider
# without the key logs a warning and falls back — the status endpoint reports both the
# requested and the effective provider.
# -------------------------------------------------------------------------------------
LLM_PROVIDER=demo
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# hashing = deterministic feature-hashing embedder (offline, reproducible, testable).
# gemini = live embeddings. Changing EMBEDDING_DIM or the provider requires
# `python manage.py reembed` — mixing vectors from two providers in one index produces
# arithmetically valid, semantically meaningless scores.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=384

# Hybrid retrieval channel weights. Fingerprint is weighted highest because an exact
# shared error code is the strongest evidence available in support search.
RETRIEVAL_W_VECTOR=1.0
RETRIEVAL_W_LEXICAL=0.9
RETRIEVAL_W_FINGERPRINT=1.4
RETRIEVAL_W_METADATA=0.6
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_LIMIT=50

# -------------------------------------------------------------------------------------
# Jira Service Management
#
# Unset = the simulated ticket provider. Ticket workflows are fully functional and every
# synchronisation run is recorded with was_simulated=true.
#
# With all four set, the integration reaches `configured` — NOT `connected`. Only a
# successful connection test (POST /api/v1/integrations/{id}/test-connection/) can
# produce `connected`.
# -------------------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# At least 16 characters. Webhook delivery stays disabled until this is set.
JIRA_WEBHOOK_SECRET=

# -------------------------------------------------------------------------------------
# IOMETE connector
#
# base_url is your deployment's Iceberg REST Catalog endpoint, served through the IOMETE
# Gateway. COMPASS speaks the published Iceberg REST Catalog specification
# (GET /v1/config, /v1/namespaces, /v1/namespaces/{ns}/tables) and calls no undocumented
# endpoint.
#
# Connected mode reads catalog metadata. It cannot execute SQL: IOMETE's documented query
# interfaces are HiveServer2 JDBC (10000), Spark Connect (15002) and Arrow Flight (33333),
# all driver-based. COMPASS says so rather than returning synthetic rows under a
# connected label.
# -------------------------------------------------------------------------------------
IOMETE_BASE_URL=
IOMETE_API_TOKEN=
IOMETE_WORKSPACE=
IOMETE_VERIFY_TLS=true
INTEGRATION_HTTP_TIMEOUT=10

# -------------------------------------------------------------------------------------
# Background jobs — optional. COMPASS is fully functional without a broker; tasks then
# run inline.
# -------------------------------------------------------------------------------------
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------------------------
# Rate limits
# -------------------------------------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_PUBLIC=30/min
THROTTLE_AI=20/min
THROTTLE_AUTH=10/min

# -------------------------------------------------------------------------------------
# Uploads
# -------------------------------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_EXTENSIONS=txt,log,json,yaml,yml,csv,png,jpg,jpeg

# -------------------------------------------------------------------------------------
# Frontend (consumed by Next.js — NEXT_PUBLIC_* values reach the browser, so never put a
# secret here)
# -------------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
